{
  "id": "nioh-2",
  "name": "Nioh 2 – The Complete Edition",
  "publisher": "Team Ninja / Koei Tecmo",
  "steamAppId": 1325200,
  "exePatterns": [
    "nioh2.exe"
  ],
  "bottle": {
    "windowsVersion": "win10",
    "translationLayer": "d3dmetal",
    "dxvk": false,
    "dxvkAsync": false,
    "enhancedSync": "msync",
    "avxEnabled": true,
    "metalHud": true,
    "dxrEnabled": false
  },
  "environment": {
    "WINEDLLOVERRIDES": "d3d11,dxgi,d3d12,d3d10,atidxx64,nvapi64,nvngx=b",
    "MTL_HUD_ENABLED": "1",
    "D3DM_ENABLE_METALFX": "1",
    "D3DM_SHOW_HUD_STATS": "1"
  },
  "winetricks": [
    "vcrun2019",
    "vcrun2022"
  ],
  "launchArgs": "",
  "notes": "Team Ninja DX11 → D3DMetal (Skyrim/FO4 class). Launch nioh2.exe with SteamAppId=1325200. This is the Complete Edition SKU, not Nioh (2017). Pin CX_GRAPHICS_BACKEND=d3dmetal. Do not use Libraries.rgl or Libraries.vk."
}
