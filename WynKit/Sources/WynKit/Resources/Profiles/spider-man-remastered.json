{
  "id": "spider-man-remastered",
  "name": "Marvel's Spider-Man Remastered",
  "publisher": "Insomniac Games",
  "steamAppId": 1817070,
  "exePatterns": [
    "spider-man.exe"
  ],
  "bottle": {
    "windowsVersion": "win10",
    "translationLayer": "d3dmetal",
    "dxvk": false,
    "dxvkAsync": false,
    "enhancedSync": "msync",
    "avxEnabled": true,
    "metalHud": true,
    "dxrEnabled": true
  },
  "environment": {
    "WINEDLLOVERRIDES": "d3d11,dxgi,d3d12,d3d10,atidxx64,nvapi64,nvngx=b",
    "MTL_HUD_ENABLED": "1",
    "D3DM_ENABLE_METALFX": "1",
    "D3DM_SHOW_HUD_STATS": "1"
  },
  "winetricks": [
    "vcrun2019",
    "vcrun2022"
  ],
  "launchArgs": "",
  "notes": "Nixxes DX12 → D3DMetal (Control class). Ray tracing is DXR via D3DMetal on M3/M4; DLSS (nvngx) cannot run on Apple Silicon. First run hitching is PSO translation. Do not use Libraries.rgl or Libraries.vk."
}
