{
  "id": "what-remains-of-edith-finch",
  "name": "What Remains of Edith Finch",
  "publisher": "Giant Sparrow / Annapurna Interactive",
  "steamAppId": 501300,
  "exePatterns": [
    "finchgame.exe"
  ],
  "bottle": {
    "windowsVersion": "win10",
    "translationLayer": "d3dmetal",
    "dxvk": false,
    "dxvkAsync": false,
    "enhancedSync": "msync",
    "avxEnabled": true,
    "metalHud": true,
    "dxrEnabled": false
  },
  "environment": {
    "WINEDLLOVERRIDES": "d3d11,dxgi,d3d12,d3d10,atidxx64,nvapi64,nvngx=b",
    "MTL_HUD_ENABLED": "1",
    "D3DM_ENABLE_METALFX": "1",
    "D3DM_SHOW_HUD_STATS": "1"
  },
  "winetricks": [
    "vcrun2019",
    "vcrun2022"
  ],
  "launchArgs": "-dx11",
  "unrealProject": "FinchGame",
  "notes": "UE4 DX11 → D3DMetal (Jedi Fallen Order class). Prefer FinchGame.exe in FinchGame\\Binaries\\Win64 with SteamAppId=501300. -dx11 pins the Unreal RHI. Pin CX_GRAPHICS_BACKEND=d3dmetal. Do not use Libraries.rgl or Libraries.vk."
}
