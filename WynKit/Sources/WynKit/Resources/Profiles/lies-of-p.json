{
  "id": "lies-of-p",
  "name": "Lies of P",
  "publisher": "Round8 Studio / Neowiz",
  "steamAppId": 1627720,
  "exePatterns": [
    "lop-win64-shipping.exe",
    "liesofp.exe"
  ],
  "bottle": {
    "windowsVersion": "win10",
    "translationLayer": "d3dmetal",
    "dxvk": false,
    "dxvkAsync": false,
    "enhancedSync": "msync",
    "avxEnabled": true,
    "metalHud": true,
    "dxrEnabled": false
  },
  "environment": {
    "WINEDLLOVERRIDES": "d3d11,dxgi,d3d12,d3d10,atidxx64,nvapi64,nvngx=b",
    "MTL_HUD_ENABLED": "1",
    "D3DM_ENABLE_METALFX": "1",
    "D3DM_SHOW_HUD_STATS": "1"
  },
  "winetricks": [
    "vcrun2019",
    "vcrun2022"
  ],
  "launchArgs": "-dx11",
  "unrealProject": "LOP",
  "notes": "UE4 DX11 → D3DMetal (Jedi Fallen Order class). Prefer LOP-Win64-Shipping.exe over LiesofP.exe with SteamAppId=1627720. -dx11 pins the Unreal RHI. Pin CX_GRAPHICS_BACKEND=d3dmetal. Do not use Libraries.rgl or Libraries.vk."
}
