{
  "id": "cyberpunk-2077",
  "name": "Cyberpunk 2077",
  "publisher": "CD Projekt Red",
  "steamAppId": 1091500,
  "exePatterns": [
    "cyberpunk2077.exe",
    "redprelauncher.exe",
    "redlauncher.exe"
  ],
  "bottle": {
    "windowsVersion": "win10",
    "translationLayer": "d3dmetal",
    "dxvk": false,
    "dxvkAsync": false,
    "enhancedSync": "msync",
    "avxEnabled": true,
    "metalHud": true,
    "dxrEnabled": true
  },
  "environment": {
    "WINEDLLOVERRIDES": "d3d11,dxgi,d3d12,d3d10,atidxx64,nvapi64,nvngx=b",
    "MTL_HUD_ENABLED": "1",
    "D3DM_ENABLE_METALFX": "1",
    "D3DM_SHOW_HUD_STATS": "1"
  },
  "winetricks": [
    "vcrun2022"
  ],
  "launchArgs": "--launcher-skip -skipStartScreen",
  "notes": "DX12-first stack probe (owns Steam app 1091500 on SSD). Prefer GPTK+D3DMetal 3.0 when Logged On; else frankea auth + DXVK-macOS. Native Mac exists — this profile is for Wyn Wine path."
}
