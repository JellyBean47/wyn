# Hash-pinned Wine tarballs. Keep in sync with DEPENDENCIES.md
WINE_WHISKYCDN_VERSION=3.1.1
WINE_WHISKYCDN_URL=https://github.com/frankea/Whisky/releases/download/v3.1.1/Libraries.tar.gz
WINE_WHISKYCDN_SHA256=01f3a1b43b98065fe20c529c1023b61dd79a6d2ad93bba6040865f646481ccf3

# D3DMetal game-host is self-built winecx (scripts/build-foss-game-host.sh).
# wyn runtime install --gptk-aware does not download Wine.
# These vars name a historical Whisky tarball that must not be installed as Libraries/.
WINE_GPTKAWARE_VERSION=wine-v26.1.0-foss-phase1l-not-game-host
WINE_GPTKAWARE_URL=https://github.com/EricSpencer00/Whisky/releases/download/wine-v26.1.0-foss-phase1l/Libraries.tar.gz
WINE_GPTKAWARE_SHA256=645917a4135c2ce83047186b6a352bf0d03ff785468e0c276db800ae044ab634

# winecx-gptk CI pins (frankea/winecx-gptk workflow env). Not a tarball Wyn fetches.
WINECX_REPO=https://github.com/dappermint/winecx.git
WINECX_COMMIT=c2cce0e61e01dd6e03ee854af526cc17d4412b52
NIXPKGS_REV=ac62194c3917d5f474c1a844b6fd6da2db95077d
MACOSX_DEPLOYMENT_TARGET=15.0

# Apple Game Porting Toolkit 3.0, the image developer.apple.com serves. From 1.1
# the release image carries its "Evaluation environment for Windows games"
# volume unmodified (Apple SLA EA18380 §2A(iii) + §2C: free, non-commercial
# redistribution only). Not 4.0: that is a beta, and pre-release software stays
# out of a release. The source repository never contains it.
GPTK_VERSION=3.0
GPTK_DMG_SHA256=ac8f6eeb2b9e5244d4c8eeb5b69b5cec099b560b143a7e5ef413945fc48b0f8f

# WineHQ MSI matching live Libraries/Wine. winecx addons.c wants 11.2.0;
# frankea Wine 11.0 wants 10.4.1. scripts/install-wine-mono.sh picks by ntdll hook.
# SHA for 11.2.0 is winecx dlls/appwiz.cpl/addons.c MONO_SHA at WINECX_COMMIT.
WINE_MONO_VERSION=11.2.0
WINE_MONO_SHA256=b4525679e7da30d4658ceb85739cbc55c771791054abbb4b3152fe96ded0b897
WINE_MONO_FRANKEA_VERSION=10.4.1
WINE_MONO_FRANKEA_SHA256=071f4b2887e1c97a11d791ff3d65be9429eed6dec4c2708888bfd546ba358e23
WINE_MONO_SOURCE_URL=https://dl.winehq.org/wine/wine-mono/11.2.0/wine-mono-11.2.0-src.tar.xz
# GitHub's digest for the same file in madewokherd/wine-mono's release; that
# release's MSI digest equals WINE_MONO_SHA256 above (checked 27 Sep 2026).
WINE_MONO_SOURCE_SHA256=aebef9b43dca80b3ebe4a0ada0f45925d833f371ba5b42f5acf9990461568ba9

# Translation layers the bundled runtime carries (stage-runtime.sh), taken from
# their publishers' own GitHub releases. Checked 27 Sep 2026 against the copies
# frankea v3.1.1 ships, which Wyn's DXMT/DXVK profiles were verified on: DXVK is
# identical file for file; DXMT is identical except the D3D trio's 16-byte
# builtin marker, which stage-runtime.sh rewrites the same way.
DXVK_MACOS_VERSION=1.10.3-20230507-repack
DXVK_MACOS_URL=https://github.com/Gcenx/DXVK-macOS/releases/download/v1.10.3-20230507-repack/dxvk-macOS-async-v1.10.3-20230507-repack.tar.gz
DXVK_MACOS_SHA256=acd1520ad105d8ef124a09c8e11a259a5dc8bdc565ad18e0e52693f9807b2477
DXVK_MACOS_SOURCE_URL=https://github.com/Gcenx/DXVK-macOS/archive/refs/tags/v1.10.3-20230507-repack.tar.gz
# GitHub's own digest for the asset; v0.80 is the last MIT release (1.0+ is LGPL).
DXMT_VERSION=0.80
DXMT_URL=https://github.com/3Shain/dxmt/releases/download/v0.80/dxmt-v0.80-builtin.tar.gz
DXMT_SHA256=8f260e36b5739e68f3bad613381441385c4dc7b85b78ba8de653d5a6a264529d
DXMT_SOURCE_URL=https://github.com/3Shain/dxmt/archive/refs/tags/v0.80.tar.gz
