# Hash-pinned Wine tarballs. Keep in sync with DEPENDENCIES.md
WINE_WHISKYCDN_VERSION=3.1.1
WINE_WHISKYCDN_URL=https://github.com/frankea/Whisky/releases/download/v3.1.1/Libraries.tar.gz
WINE_WHISKYCDN_SHA256=01f3a1b43b98065fe20c529c1023b61dd79a6d2ad93bba6040865f646481ccf3

# D3DMetal game-host is self-built winecx (scripts/build-foss-game-host.sh).
# wyn runtime install --gptk-aware does not download Wine.
# These vars name a historical Whisky tarball that must not be installed as Libraries/.
WINE_GPTKAWARE_VERSION=wine-v26.1.0-foss-phase1l-not-game-host
WINE_GPTKAWARE_URL=https://github.com/EricSpencer00/Whisky/releases/download/wine-v26.1.0-foss-phase1l/Libraries.tar.gz
WINE_GPTKAWARE_SHA256=645917a4135c2ce83047186b6a352bf0d03ff785468e0c276db800ae044ab634

# winecx-gptk CI pins (frankea/winecx-gptk workflow env). Not a tarball Wyn fetches.
WINECX_REPO=https://github.com/dappermint/winecx.git
WINECX_COMMIT=c2cce0e61e01dd6e03ee854af526cc17d4412b52
NIXPKGS_REV=ac62194c3917d5f474c1a844b6fd6da2db95077d
MACOSX_DEPLOYMENT_TARGET=15.0

# WineHQ MSI matching live Libraries/Wine. winecx addons.c wants 11.2.0;
# frankea Wine 11.0 wants 10.4.1. scripts/install-wine-mono.sh picks by ntdll hook.
# SHA for 11.2.0 is winecx dlls/appwiz.cpl/addons.c MONO_SHA at WINECX_COMMIT.
WINE_MONO_VERSION=11.2.0
WINE_MONO_SHA256=b4525679e7da30d4658ceb85739cbc55c771791054abbb4b3152fe96ded0b897
WINE_MONO_FRANKEA_VERSION=10.4.1
WINE_MONO_FRANKEA_SHA256=071f4b2887e1c97a11d791ff3d65be9429eed6dec4c2708888bfd546ba358e23
