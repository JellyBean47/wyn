# Libraries the bundled Wine runtime loads, built from these upstream tarballs
# by scripts/build-runtime-deps.sh. The tarballs are also the LGPL corresponding
# source: scripts/package-sources.sh ships them next to the release image.
#
# Only what Wine actually opens (winecx config.h SONAME_*): FreeType, GnuTLS,
# SDL2, MoltenVK. zlib, bzip2, iconv and Kerberos come from macOS itself.
#
# name|version|url|sha256|licence
DEP_GMP="gmp|6.3.0|https://ftp.gnu.org/gnu/gmp/gmp-6.3.0.tar.xz|a3c2b80201b89e68616f4ad30bc66aee4927c3ce50e33929ca819d5c43538898|LGPL-3.0-or-later OR GPL-2.0-or-later"
DEP_NETTLE="nettle|3.10.2|https://ftp.gnu.org/gnu/nettle/nettle-3.10.2.tar.gz|fe9ff51cb1f2abb5e65a6b8c10a92da0ab5ab6eaf26e7fc2b675c45f1fb519b5|LGPL-3.0-or-later OR GPL-2.0-or-later"
DEP_TASN1="libtasn1|4.21.0|https://ftp.gnu.org/gnu/libtasn1/libtasn1-4.21.0.tar.gz|1d8a444a223cc5464240777346e125de51d8e6abf0b8bac742ac84609167dc87|LGPL-2.1-or-later"
DEP_GNUTLS="gnutls|3.8.13|https://www.gnupg.org/ftp/gcrypt/gnutls/v3.8/gnutls-3.8.13.tar.xz|ffed8ec1bf09c2426d4f14aae377de4753b53e537d685e604e99a8b16ca9c97e|LGPL-2.1-or-later"
DEP_LIBPNG="libpng|1.6.58|https://download.sourceforge.net/libpng/libpng-1.6.58.tar.xz|28eb403f51f0f7405249132cecfe82ea5c0ef97f1b32c5a65828814ae0d34775|libpng-2.0"
DEP_FREETYPE="freetype|2.14.3|https://download.savannah.gnu.org/releases/freetype/freetype-2.14.3.tar.xz|36bc4f1cc413335368ee656c42afca65c5a3987e8768cc28cf11ba775e785a5f|FTL OR GPL-2.0-only"
DEP_SDL2="SDL2|2.32.10|https://github.com/libsdl-org/SDL/releases/download/release-2.32.10/SDL2-2.32.10.tar.gz|5f5993c530f084535c65a6879e9b26ad441169b3e25d789d83287040a9ca5165|Zlib"
# Khronos' own release. Apache-2.0: redistributable as a binary with its licence.
DEP_MOLTENVK="MoltenVK|1.4.2|https://github.com/KhronosGroup/MoltenVK/releases/download/v1.4.2/MoltenVK-macos.tar|f95765a6229cb7b915990a2890ce12ebe36a730b021545d3d52ae69ce4c4024e|Apache-2.0"
