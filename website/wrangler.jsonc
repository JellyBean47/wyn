{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dry-forest-c815",
  "main": "worker.mjs",
  "compatibility_date": "2026-09-07",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "kv_namespaces": [
    {
      "binding": "SUBMISSIONS",
      "id": "281db8560064453286464d44500983df"
    }
  ],
  "ratelimits": [
    {
      "name": "SUBMISSION_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 10,
        "period": 60
      }
    }
  ],
  "account_id": "a7dea0f41f7bdebec4507e7a29151c89",
  "workers_dev": true,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "wyn-dev.com",
      "custom_domain": true
    },
    {
      "pattern": "www.wyn-dev.com",
      "custom_domain": true
    }
  ]
}
