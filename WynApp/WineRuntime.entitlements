<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Entitlements for the Wine executables (bin/wine, bin/wineserver) that
  Wyn.app carries from 1.1 on. Notarization requires the hardened runtime on
  every executable in the bundle, and the hardened runtime by default forbids
  what Wine does for a living:

  - allow-unsigned-executable-memory: Windows code is mapped from PE files and
    VirtualAlloc(PAGE_EXECUTE_*) memory, none of it code-signed.
  - allow-jit: MAP_JIT regions (Rosetta-hosted JITs in games, .NET, CEF).
  - disable-library-validation: Wine dlopens libraries from the runtime tree
    that Wyn rewrites after install (MoltenVK shim, GPTK wiring), and Apple's
    D3DMetal is signed by Apple rather than by Wyn's team.
  - allow-dyld-environment-variables: Connect and storefront launches inject
    Wyn's helper dylibs with DYLD_INSERT_LIBRARIES; the hardened runtime
    strips DYLD_* otherwise.
  - device.audio-input: games with voice chat open the microphone through
    CoreAudio; without it the hardened runtime denies capture outright.

  Libraries (.so/.dylib) are signed without entitlements: entitlements belong
  to the executable that loads them.
-->
<plist version="1.0">
<dict>
	<key>com.apple.security.cs.allow-unsigned-executable-memory</key>
	<true/>
	<key>com.apple.security.cs.allow-jit</key>
	<true/>
	<key>com.apple.security.cs.disable-library-validation</key>
	<true/>
	<key>com.apple.security.cs.allow-dyld-environment-variables</key>
	<true/>
	<key>com.apple.security.device.audio-input</key>
	<true/>
</dict>
</plist>
